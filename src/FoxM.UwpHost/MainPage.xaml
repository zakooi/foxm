<Page
    x:Class="FoxM.UwpHost.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FoxM.UwpHost"
    xmlns:services="using:FoxM.UwpHost.Services"
    xmlns:goanna="using:FoxM.GoannaRuntime"
    Background="#FF121214"
    Loaded="Page_Loaded">

    <Grid>
        <!-- Layout Chính 4 Dòng: Header -> Progress -> Viewport -> Bottom Bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER & OMNIBOX -->
        <Border Grid.Row="0" Background="#FF1E1E22" Padding="8,6" BorderBrush="#FF2A2A30" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & TLS Lock Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Border Background="#FFD85012" CornerRadius="4" Padding="6,4">
                        <TextBlock Text="🦊" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="SslBadgeButton" Content="🔒" Background="Transparent" Foreground="#FF4CAF50" 
                            FontSize="12" Padding="4,0" Margin="2,0,0,0" ToolTipService.ToolTip="Kết nối Gecko / Mozilla NSS TLS 1.3"/>
                </StackPanel>

                <!-- Omnibox URL Box -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="UrlTextBox" Height="36" FontSize="13" 
                             PlaceholderText="Nhập địa chỉ web hoặc tìm kiếm..." 
                             KeyDown="UrlTextBox_KeyDown"
                             TextChanged="UrlTextBox_TextChanged"
                             Background="#FF141416" Foreground="#FFF0F0F0" 
                             BorderBrush="#FF3A3A42" Padding="8,6,28,6"/>
                    
                    <Button x:Name="ClearUrlButton" Content="✕" Width="24" Height="24" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                            Background="Transparent" Foreground="#FF888888" FontSize="11" 
                            Visibility="Collapsed" Click="ClearUrlButton_Click"/>
                </Grid>

                <!-- Quick Action Button (Go / Bookmark) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button x:Name="BookmarkStarButton" Content="⭐" Width="36" Height="36" 
                            Background="#FF2A2A30" Foreground="#FFFFC107" FontSize="13" 
                            Click="BookmarkStarButton_Click" ToolTipService.ToolTip="Lưu dấu trang"/>
                    <Button x:Name="GoButton" Content="➔" Width="36" Height="36" Margin="4,0,0,0"
                            Click="GoButton_Click" Background="#FFD85012" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. PROGRESS BAR -->
        <ProgressBar x:Name="WebProgressBar" Grid.Row="1" Height="3" Foreground="#FFD85012" Visibility="Collapsed"/>

        <!-- 3. VIEWPORT CONTAINER (Dual-Engine Architecture: Full Web + Goanna Direct2D C++) -->
        <Grid x:Name="ViewportContainer" Grid.Row="2" Background="#FF121214">
            <!-- Active Full Web Viewport with Modern Gecko Header Spoofing & DOM Polyfills -->
            <WebView x:Name="BrowserCore" 
                     HorizontalAlignment="Stretch" 
                     VerticalAlignment="Stretch"
                     NavigationStarting="BrowserCore_NavigationStarting"
                     ContentLoading="BrowserCore_ContentLoading"
                     DOMContentLoaded="BrowserCore_DOMContentLoaded"
                     NavigationCompleted="BrowserCore_NavigationCompleted"
                     LongRunningScriptDetected="BrowserCore_LongRunningScriptDetected"/>

            <!-- Goanna Direct2D 1.2 Hardware SwapChainPanel Control (Reader & Fast GPU Mode) -->
            <goanna:GoannaView x:Name="GoannaCore" 
                               HorizontalAlignment="Stretch" 
                               VerticalAlignment="Stretch"
                               Visibility="Collapsed"
                               NavigationStarting="GoannaCore_NavigationStarting"
                               NavigationCompleted="GoannaCore_NavigationCompleted"
                               TitleChanged="GoannaCore_TitleChanged"
                               ProgressChanged="GoannaCore_ProgressChanged"/>

            <!-- Màn hình chào ban đầu -->
            <StackPanel x:Name="WelcomeOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Visibility="Visible">
                <TextBlock Text="🦊 FoxM Browser v1.1" FontSize="24" FontWeight="Bold" Foreground="#FFD85012" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Trình duyệt Goanna / Gecko C++ cho Windows 10 Mobile" TextAlignment="Center" Foreground="#FFAAAAAA" FontSize="13" Margin="0,0,0,16"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="DuckDuckGo" Margin="4" Background="#FF222228" Foreground="White" Click="QuickLink_Click" Tag="https://duckduckgo.com"/>
                    <Button Content="Google" Margin="4" Background="#FF222228" Foreground="White" Click="QuickLink_Click" Tag="https://www.google.com"/>
                    <Button Content="VnExpress" Margin="4" Background="#FF222228" Foreground="White" Click="QuickLink_Click" Tag="https://vnexpress.net"/>
                </StackPanel>
            </StackPanel>

            <!-- Màn hình thông báo lỗi kết nối -->
            <Grid x:Name="ErrorOverlay" Background="#FF18181C" Visibility="Collapsed" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Không thể tải trang" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ErrorMessageText" Text="Vui lòng kiểm tra kết nối Wi-Fi / 3G hoặc địa chỉ web." Foreground="#FFAAAAAA" FontSize="12" TextAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <Button Content="🔄 Thử Lại" HorizontalAlignment="Center" Background="#FFD85012" Foreground="White" FontWeight="Bold" Height="40" Padding="16,0" Click="RetryButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 4. BOTTOM THUMB-FRIENDLY NAVIGATION BAR (Lumia UI) -->
        <Border Grid.Row="3" Background="#FF18181C" Padding="4,2" BorderBrush="#FF2A2A30" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Content="◀" HorizontalAlignment="Stretch" Height="42" Background="Transparent" Foreground="White" FontSize="14" Click="BackButton_Click"/>
                <Button x:Name="ForwardButton" Grid.Column="1" Content="▶" HorizontalAlignment="Stretch" Height="42" Background="Transparent" Foreground="White" FontSize="14" Click="ForwardButton_Click"/>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="🔄" HorizontalAlignment="Stretch" Height="42" Background="Transparent" Foreground="White" FontSize="14" Click="RefreshButton_Click"/>
                <Button x:Name="ReaderButton" Grid.Column="3" Content="📖" HorizontalAlignment="Stretch" Height="42" Background="Transparent" Foreground="White" FontSize="14" Click="ReaderButton_Click" ToolTipService.ToolTip="Chế độ đọc"/>
                <Button x:Name="TabsButton" Grid.Column="4" Content="🗂️ 1" HorizontalAlignment="Stretch" Height="42" Background="Transparent" Foreground="#FFD85012" FontWeight="Bold" FontSize="13" Click="TabsButton_Click"/>
                <Button x:Name="MenuButton" Grid.Column="5" Content="⋮" HorizontalAlignment="Stretch" Height="42" Background="Transparent" Foreground="White" FontSize="16" Click="MenuButton_Click"/>
            </Grid>
        </Border>

        <!-- ==================== OVERLAYS & MODALS ==================== -->

        <!-- A. TAB SWITCHER OVERLAY -->
        <Grid x:Name="TabSwitcherOverlay" Grid.RowSpan="4" Background="#EE0D0D10" Visibility="Collapsed">
            <Grid Margin="16,32,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Các Tab Đang Mở" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                <ListView x:Name="TabListView" Grid.Row="1" SelectionChanged="TabListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FF222228" CornerRadius="6" Padding="12,10" Margin="0,4" BorderBrush="#FF3A3A44" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Url}" Foreground="#FF888888" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="CloseTab_Click" Background="Transparent" Foreground="#FFFF6B6B"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="➕ Tab Mới" HorizontalAlignment="Stretch" Height="44" Background="#FFD85012" Foreground="White" FontWeight="Bold" Click="NewTab_Click" Margin="0,0,4,0"/>
                    <Button Content="Đóng" HorizontalAlignment="Stretch" Height="44" Background="#FF333338" Foreground="White" Click="CloseTabSwitcher_Click" Grid.Column="1" Margin="4,0,0,0"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- B. BOOKMARKS & HISTORY MODAL -->
        <Grid x:Name="BookmarksOverlay" Grid.RowSpan="4" Background="#EE0D0D10" Visibility="Collapsed">
            <Pivot Margin="12,24,12,12">
                <PivotItem Header="Dấu trang ⭐">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListView x:Name="BookmarksListView" Grid.Row="0" ItemClick="BookmarkItem_Click" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1E1E24" CornerRadius="4" Padding="10,8" Margin="0,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                            <TextBlock Text="{Binding Url}" Foreground="#FF777777" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Đóng" Grid.Row="1" Height="40" HorizontalAlignment="Stretch" Background="#FF333338" Foreground="White" Click="CloseBookmarks_Click" Margin="0,8,0,0"/>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Lịch sử 🕒">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListView x:Name="HistoryListView" Grid.Row="0" ItemClick="HistoryItem_Click" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF1E1E24" CornerRadius="4" Padding="10,8" Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Url}" Foreground="#FF777777" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" Foreground="#FF555555" FontSize="10" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Xóa Lịch sử" Height="40" HorizontalAlignment="Stretch" Background="#FF882222" Foreground="White" Click="ClearHistory_Click" Margin="0,0,4,0"/>
                            <Button Content="Đóng" Grid.Column="1" Height="40" HorizontalAlignment="Stretch" Background="#FF333338" Foreground="White" Click="CloseBookmarks_Click" Margin="4,0,0,0"/>
                        </Grid>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Cài đặt & RAM 🛡️">
                    <StackPanel Margin="0,8">
                        <Border Background="#FF222228" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Trạng thái RAM Thiết bị (Lumia)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                <TextBlock x:Name="RamUsageText" Text="Đang đo bộ nhớ..." Foreground="#FF4CAF50" FontSize="16" FontWeight="Bold" Margin="0,8,0,4"/>
                                <ProgressBar x:Name="RamUsageBar" Height="8" Foreground="#FF4CAF50" Value="25" Maximum="100"/>
                            </StackPanel>
                        </Border>

                        <Button Content="🧹 Dọn Rác RAM (SpiderMonkey GC)" Height="44" HorizontalAlignment="Stretch" Background="#FFD85012" Foreground="White" FontWeight="Bold" Click="TrimMemoryNow_Click" Margin="0,0,0,8"/>
                        
                        <ToggleSwitch x:Name="GoannaDirect2DToggle" Header="Chế độ Goanna Direct2D GPU (Siêu nhẹ)" IsOn="False" Toggled="GoannaDirect2DToggle_Toggled" Margin="0,8,0,8"/>
                        
                        <Button Content="Đóng" Height="40" HorizontalAlignment="Stretch" Background="#FF333338" Foreground="White" Click="CloseBookmarks_Click"/>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
